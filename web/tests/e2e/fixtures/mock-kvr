// ---------------------------------------------------------------------------
// Emit workflow events with realistic delays
// ---------------------------------------------------------------------------

const PHASE_NAMES = [
  'benefits-research',
  'insurance-research',
  'evidence-verification',
  'eligibility-validation',
  'action-plan',
];

const PHASE_FILES = {
  'benefits-research': BENEFITS_RESEARCH_MD,
  'insurance-research': INSURANCE_RESEARCH_MD,
  'evidence-verification': EVIDENCE_VERIFICATION_MD,
  'eligibility-validation': ELIGIBILITY_VALIDATION_MD,
  'action-plan': ACTION_PLAN_MD,
};

// Simulate error scenario
const exitCode = parseInt(process.env.MOCK_KVR_EXIT_CODE || '0', 10);
const feedbackLoop = process.env.MOCK_KVR_FEEDBACK_LOOP === '1';

async function sleep(ms) {
  return new Promise((resolve) => setTimeout(resolve, ms));
}

async function run() {
  // workflow_start
  emitEvent({ event_type: 'workflow_start', total_phases: 5 });
  await sleep(50);

  // Phases 1 & 2 start in parallel
  emitEvent({ event_type: 'phase_start', phase: 'benefits-research' });
  emitEvent({ event_type: 'phase_start', phase: 'insurance-research' });
  await sleep(100);

  if (exitCode !== 0) {
    // Emit an error and exit
    emitEvent({
      event_type: 'error',
      phase: 'benefits-research',
      message: 'Workflow failed: mock exit code ' + exitCode,
    });
    process.exit(exitCode);
  }

  // Complete phases 1 & 2
  writePhaseFile('benefits-research', PHASE_FILES['benefits-research']);
  emitEvent({ event_type: 'phase_complete', phase: 'benefits-research' });
  await sleep(50);

  writePhaseFile('insurance-research', PHASE_FILES['insurance-research']);
  emitEvent({ event_type: 'phase_complete', phase: 'insurance-research' });
  await sleep(50);

  // Phase 3: evidence-verification
  emitEvent({ event_type: 'phase_start', phase: 'evidence-verification' });
  await sleep(100);

  if (feedbackLoop) {
    // Simulate feedback loop: phase reruns once
    emitEvent({ event_type: 'phase_start', phase: 'benefits-research' });
    await sleep(50);
    writePhaseFile('benefits-research', PHASE_FILES['benefits-research']);
    emitEvent({ event_type: 'phase_complete', phase: 'benefits-research' });
    await sleep(50);
    emitEvent({ event_type: 'phase_start', phase: 'evidence-verification' });
    await sleep(50);
  }

  writePhaseFile('evidence-verification', PHASE_FILES['evidence-verification']);
  emitEvent({ event_type: 'phase_complete', phase: 'evidence-verification' });
  await sleep(50);

  // Phase 4: eligibility-validation
  emitEvent({ event_type: 'phase_start', phase: 'eligibility-validation' });
  await sleep(100);
  writePhaseFile('eligibility-validation', PHASE_FILES['eligibility-validation']);
  emitEvent({ event_type: 'phase_complete', phase: 'eligibility-validation' });
  await sleep(50);

  // Phase 5: action-plan
  emitEvent({ event_type: 'phase_start', phase: 'action-plan' });
  await sleep(100);
  writePhaseFile('action-plan', PHASE_FILES['action-plan']);
  emitEvent({ event_type: 'phase_complete', phase: 'action-plan' });
  await sleep(50);

  process.exit(0);
}

run().catch((err) => {
  process.stderr.write(`mock-kvr error: ${err.message}\n`);
  process.exit(1);
});
