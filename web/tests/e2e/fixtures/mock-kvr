#!/usr/bin/env node
/**
 * mock-kvr — deterministic KVR fixture for Playwright E2E tests.
 *
 * Placed on PATH by playwright.config.ts so `kvr` resolves to this script
 * instead of the real binary. Emits pre-defined [PHASE_STREAM] events to
 * stdout and writes fixture .md files to .workforce/{runId}/, exercising the
 * full web-app SSE relay without real LLM calls.
 *
 * Usage (matches real kvr invocation in kvr-runner.ts):
 *   kvr run benefits-navigator --mode automated --no-progress \
 *       --run-id <uuid> --phase-stream stdout [--var key=value ...]
 *
 * Special modes (set via environment variables in tests):
 *   MOCK_KVR_EXIT_CODE=1   → emits partial events then exits non-zero (error scenario)
 *   MOCK_KVR_FEEDBACK_LOOP=1 → simulates phase rerun (evidence-verification reruns once)
 *   MOCK_KVR_WIDE_TABLE=1  → includes 10-column table in insurance-research output
 */

'use strict';

const fs = require('fs');
const path = require('path');

// ---------------------------------------------------------------------------
// Parse CLI arguments
// ---------------------------------------------------------------------------

const args = process.argv.slice(2);

if (args[0] === '--version') {
  process.stdout.write('mock-kvr 0.225.0 (E2E fixture)\n');
  process.exit(0);
}

// Find --run-id value
const runIdIdx = args.indexOf('--run-id');
const runId = runIdIdx !== -1 ? args[runIdIdx + 1] : `mock-run-${Date.now()}`;

// ---------------------------------------------------------------------------
// Determine .workforce directory (one level up from CWD = web/ → repo root)
// ---------------------------------------------------------------------------

const workforceBase = path.join(process.cwd(), '.workforce');
const runDir = path.join(workforceBase, runId);
fs.mkdirSync(runDir, { recursive: true });

// ---------------------------------------------------------------------------
// Emit a [PHASE_STREAM] event to stdout
// ---------------------------------------------------------------------------

function emitEvent(eventObj) {
  process.stdout.write(`[PHASE_STREAM] ${JSON.stringify(eventObj)}\n`);
}

// ---------------------------------------------------------------------------
// Write a fixture .md file for a phase
// ---------------------------------------------------------------------------

function writePhaseFile(phaseName, content) {
  const filePath = path.join(runDir, `${phaseName}.md`);
  fs.writeFileSync(filePath, content, 'utf8');
}

